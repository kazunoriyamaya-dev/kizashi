# =====================================================
# Kizashi 環境変数テンプレート
# 設計書 06_環境_GitHub に準拠
# 値を埋めて .env.local にコピーして使用
# 本番値は Vercel Project Settings > Environment Variables で管理
# =====================================================

# -----------------------------------------------------
# アプリ基本
# -----------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------
# Supabase（Auth/DB/Storage/RLS）
# -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 重要: 以下はサーバー専用。NEXT_PUBLIC_ プレフィックス不可。クライアントに絶対露出させない。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# -----------------------------------------------------
# Stripe（決済 + Connect）
# -----------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Stripe Connect クライアントID（Express接続時）
STRIPE_CONNECT_CLIENT_ID=ca_...

# -----------------------------------------------------
# Google OAuth + Calendar API
# -----------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# OAuthコールバック例: ${APP_URL}/api/instructor/google-calendar/callback

# -----------------------------------------------------
# Google Maps Routes API（交通費計算）
# -----------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSyXxxxxxxx
# サーバー側のみで利用、API制限と請求上限の設定推奨

# -----------------------------------------------------
# LINE Login + Messaging API
# -----------------------------------------------------
LINE_CLIENT_ID=2000000000
LINE_CLIENT_SECRET=xxxxxxxxxxxx
# Messaging API（顧客向け通知）
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxx
LINE_CHANNEL_SECRET=xxxxxxxxxxxx

# -----------------------------------------------------
# メール（Resend）
# -----------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@kizashi.example.com
EMAIL_REPLY_TO=support@kizashi.example.com

# -----------------------------------------------------
# Web Push 通知（VAPID）
# 生成コマンド: npx web-push generate-vapid-keys
# -----------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:support@kizashi.example.com

# -----------------------------------------------------
# 暗号化鍵（OAuth refresh_token 等の暗号化用）
# 生成コマンド: openssl rand -base64 32
# -----------------------------------------------------
ENCRYPTION_KEY=base64-encoded-32-byte-key

# -----------------------------------------------------
# Vercel Cron 認証（cron エンドポイント保護）
# -----------------------------------------------------
CRON_SECRET=random-long-string

# -----------------------------------------------------
# 管理者初期登録時の招待トークン
# -----------------------------------------------------
ADMIN_BOOTSTRAP_TOKEN=random-long-string

# =====================================================
# マーケティング自動化システム (Phase 15)
# =====================================================
# 以下はオプション。未設定なら該当連携をスキップ (no-op) する。

# --- SNS パブリッシャー -----------------------------
# X (Twitter)
TWITTER_BEARER_TOKEN=
# Meta (Facebook / Instagram)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# TikTok
TIKTOK_ACCESS_TOKEN=
# YouTube
YOUTUBE_ACCESS_TOKEN=

# --- 広告メトリクス API -----------------------------
META_AD_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_ACCESS_TOKEN=

# --- アフィリエイト ASP postback 共通シークレット -----
# /api/marketing/affiliate-webhook/[network] にこの値を Authorization Bearer で送る
AFFILIATE_WEBHOOK_SECRET=random-long-string

# =====================================================
# サイト運営者情報 (法的表記 / お問い合わせ / 自動返信メールで使用)
# =====================================================
# 未設定時は src/lib/site-config.ts のデフォルト値 (プレースホルダ) が使われる。
# 本番では必ず実情報を設定すること。
SITE_OPERATOR_NAME=
SITE_OPERATOR_REPRESENTATIVE=
SITE_OPERATOR_ADDRESS=
SITE_OPERATOR_PHONE=
CONTACT_EMAIL=support@kizashi.example.com
PRIVACY_OFFICER=
SUPPORT_URL=
